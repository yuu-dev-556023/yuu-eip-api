    <PackageVersion Include="Volo.Abp.Swashbuckle" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Account.Web.OpenIddict" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.0.2" />
    <PackageVersion Include="Yuu.AspNetCore.Hosting" Version="10.0.2" />
    <PackageVersion Include="Yuu.AspNetCore.Middleware" Version="10.0.3" />
    <PackageVersion Include="Yuu.AspNetCore.Mvc" Version="10.0.1" />
    <PackageVersion Include="Yuu.ClientInfo.Provider" Version="10.0.2" />
    <PackageVersion Include="Yuu.Environment.Provider" Version="10.0.2" />
    <PackageVersion Include="Yuu.Serilog.Seq" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
  </ItemGroup>

  <!-- ============================================================================= -->
  <!-- Test Projects (test/)                                                         -->
  <!-- ============================================================================= -->

  <ItemGroup Label="Yuu.Eip.Application.Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.Domain.Tests">
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.EntityFrameworkCore.Tests">
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.HttpApi.Client.ConsoleTestApp">
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.TestBase">
    <PackageVersion Include="Volo.Abp.TestBase" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Authorization" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Abstractions" Version="10.0.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
