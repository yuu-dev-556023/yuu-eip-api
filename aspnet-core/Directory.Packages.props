<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    <!-- Do not warn for missing source mappings -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <!-- ============================================================================= -->
  <!-- Source Projects (src/)                                                       -->
  <!-- ============================================================================= -->

  <ItemGroup Label="Yuu.Eip.Application">
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="0.6.0-preview.1" />
    <PackageVersion Include="Volo.Abp.Account.Application" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Identity.Application" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Application" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.TenantManagement.Application" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Application" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Application" Version="10.0.2" />
    <PackageVersion Include="Yuu.ClientInfo.Provider.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Yuu.Environment.Provider.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.Application.Contracts">
    <PackageVersion Include="Volo.Abp.ObjectExtending" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Account.Application.Contracts" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Identity.Application.Contracts" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Application.Contracts" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.TenantManagement.Application.Contracts" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Application.Contracts" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Application.Contracts" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.DbMigrator">
    <PackageVersion Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Autofac" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.Domain">
    <PackageVersion Include="Volo.Abp.Emailing" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Identity.Domain" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Domain" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.AuditLogging.Domain" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.TenantManagement.Domain" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Domain" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Domain" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.OpenIddict.Domain" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.Domain.Shared">
    <PackageVersion Include="Volo.Abp.Identity.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.AuditLogging.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.TenantManagement.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.OpenIddict.Domain.Shared" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.EntityFrameworkCore">
    <PackageVersion Include="EFCore.CheckConstraints" Version="10.0.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Identity.EntityFrameworkCore" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="10.0.2" />
