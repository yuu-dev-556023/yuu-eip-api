    <PackageVersion Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="10.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.2" />
    <PackageVersion Include="Yuu.Abp.EntityFrameworkCore" Version="10.0.2" />
    <PackageVersion Include="Yuu.EntityFrameworkCore.Logging" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.HttpApi">
    <PackageVersion Include="Volo.Abp.Account.HttpApi" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Identity.HttpApi" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.HttpApi" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.TenantManagement.HttpApi" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.HttpApi" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.SettingManagement.HttpApi" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="Yuu.Eip.HttpApi.Client">
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="9.0.6" />
    <PackageVersion Include="Volo.Abp.Http.Client.IdentityModel" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Account.HttpApi.Client" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.Identity.HttpApi.Client" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.HttpApi.Client" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.TenantManagement.HttpApi.Client" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.HttpApi.Client" Version="10.0.2" />
    <PackageVersion Include="Volo.Abp.SettingManagement.HttpApi.Client" Version="10.0.2" />
